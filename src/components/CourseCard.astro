---
interface Props {
  title: string;
  href: string;
  description: string;
  icon: string;
  meta?: string;
}
const { title, href, description, icon, meta } = Astro.props;
---

<a href={href} class="course-card">
  <span class="icon" set:html={icon} />
  <span class="content">
    <span class="title">{title}</span>
    {meta && <span class="meta">{meta}</span>}
    <span class="desc">{description}</span>
  </span>
  <span class="arrow">→</span>
</a>

<style>
  .course-card {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    padding: 1.4rem 1.5rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.75rem;
    text-decoration: none;
    background: linear-gradient(180deg, rgba(79,110,247,0.08), rgba(79,110,247,0.02));
    transition: border-color 0.2s, transform 0.2s, background 0.2s;
  }
  .course-card:hover {
    border-color: var(--sl-color-accent);
    background: linear-gradient(180deg, rgba(79,110,247,0.14), rgba(79,110,247,0.04));
    transform: translateY(-1px);
  }
  .icon {
    font-size: 1.7rem;
    line-height: 1;
    flex-shrink: 0;
    margin-top: 0.1rem;
  }
  .content {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    flex: 1;
  }
  .title {
    font-weight: 700;
    color: var(--sl-color-white);
    font-size: 1.05rem;
  }
  .meta {
    font-size: 0.8rem;
    color: var(--sl-color-accent-high);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .desc {
    font-size: 0.92rem;
    color: var(--sl-color-gray-3);
    line-height: 1.45;
  }
  .arrow {
    color: var(--sl-color-accent);
    font-size: 1.1rem;
    flex-shrink: 0;
    margin-top: 0.1rem;
  }
</style>
